# MongoDB Atlas → Connect → Drivers. The app always uses the "prakashjewellers" database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public address, e.g. https://prakashjewellers.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary → Settings → API Keys. The key's role must allow uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
